{
  "name": "ymb",
  "version": "1.2.1",
  "description": "AI-ready WARNO mod builder for conflict-free updates, resilient source mods, YAML/NDF patching, generated outputs, and safe sync",
  "homepage": "https://github.com/Yokaiste/YMB",
  "author": "Yokaiste",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yokaiste/YMB.git"
  },
  "bugs": {
    "url": "https://discord.gg/33Sqn6dTjf"
  },
  "type": "module",
  "module": "index.ts",
  "bin": {
    "ymb": "./index.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "Use Bun instead of Node.js",
    "npm": "Use Bun instead of npm",
    "yarn": "Use Bun instead of yarn"
  },
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "lint": "bun run prettier && bun run biome",
    "fix": "bun run prettier:fix && bun run biome:fix",
    "prettier": "prettier --ignore-path .gitignore --ignore-unknown .",
    "prettier:fix": "prettier --ignore-path .gitignore --ignore-unknown --write .",
    "biome": "biome check . && biome format .",
    "biome:fix": "biome check --write . && biome format --write .",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "ymb": "bun run ./index.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.4",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "warno",
    "warno-modding",
    "warno-tools",
    "mod-builder",
    "ai-ready",
    "update-resilient",
    "conflict-free",
    "modular",
    "structural-patching",
    "yaml",
    "ndf",
    "ndf-patch",
    "template-expressions",
    "script-generation",
    "patch-planner",
    "conflict-detection",
    "safe-sync",
    "recovery",
    "bun",
    "game-modding"
  ]
}
